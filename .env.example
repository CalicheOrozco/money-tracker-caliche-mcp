# Public URL of this MCP server, no trailing slash
BASE_URL=http://localhost:8787
# Money Tracker app whose API this server calls
APP_URL=http://localhost:5001
# Database for OAuth clients and tokens (can be the same cluster as the app)
MONGODB_URI=
MCP_DB=money-tracker-mcp
# Random string, 32+ characters. Generate with: openssl rand -base64 48
MCP_SECRET=
# Timezone for "today" and "this month"
TIMEZONE=America/Moncton
